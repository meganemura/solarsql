     plan: ["insert into inventory (sku, qty) values (:sku, :qty) on conflict (sku) do update set qty = excluded.qty"],
     returns: "select sku, qty from inventory where sku = :sku",
   },
+  cancel: {
+    plan: [
+      assert("not_confirmed", "exists (select 1 from orders where id = :id and status = 'confirmed')"),
+      // The cap check runs before the restock, grouped by sku, because two
+      // lines of the same order can share a sku.
+      assert(
+        "restock_failed",
+        `not exists (
+          select 1
+          from (select sku, sum(qty) as qty from order_lines where order_id = :id group by sku) restock
+          join inventory on inventory.sku = restock.sku
+          where inventory.qty + restock.qty > 100
+        )`,
+      ),
+      "update orders set status = 'cancelled' where id = :id",
+      `update inventory
+       set qty = qty + (
+         select coalesce(sum(qty), 0) from order_lines where order_lines.sku = inventory.sku and order_lines.order_id = :id
+       )
+       where sku in (select sku from order_lines where order_id = :id)`,
+    ],
+    returns: "select id, customer_id, status, note from orders where id = :id",
+  },
 });
