@@ -98,4 +98,52 @@
     assert.deepEqual(await value({ step: "stock", sku: "A" }), { sku: "A", qty: 12 });
     assert.equal(await value({ step: "stock", sku: "B" }), null);
   });
+
+  test("cancel a confirmed order: it returns its lines to stock", async () => {
+    await value({ step: "setStock", sku: "C", qty: 5 });
+    await value({ step: "setStock", sku: "D", qty: 20 });
+    await value({
+      step: "placeOrder",
+      id: "o3",
+      customer_id: "c1",
+      lines: [
+        { id: "l3", sku: "C", qty: 3, price: 2 },
+        { id: "l4", sku: "D", qty: 4, price: 1 },
+      ],
+    });
+    assert.deepEqual(await value({ step: "confirm", id: "o3" }), { id: "o3", customer_id: "c1", status: "confirmed", note: null });
+    assert.deepEqual(await value({ step: "cancel", id: "o3" }), { id: "o3", customer_id: "c1", status: "cancelled", note: null });
+    assert.deepEqual(await value({ step: "stock", sku: "C" }), { sku: "C", qty: 8 });
+    assert.deepEqual(await value({ step: "stock", sku: "D" }), { sku: "D", qty: 24 });
+  });
+
+  test("cancelling an already-cancelled order is refused, and stock does not move again", async () => {
+    assert.deepEqual(await value({ step: "cancel", id: "o3" }), { refused: "not_confirmed" });
+    assert.deepEqual(await value({ step: "stock", sku: "C" }), { sku: "C", qty: 8 });
+    assert.deepEqual(await value({ step: "stock", sku: "D" }), { sku: "D", qty: 24 });
+  });
+
+  test("a draft order with lines cannot be cancelled, and its stock does not move", async () => {
+    await value({ step: "setStock", sku: "E", qty: 5 });
+    await value({ step: "placeOrder", id: "o5", customer_id: "c1", lines: [{ id: "l6", sku: "E", qty: 2, price: 1 }] });
+    assert.deepEqual(await value({ step: "cancel", id: "o5" }), { refused: "not_confirmed" });
+    assert.deepEqual(await value({ step: "stock", sku: "E" }), { sku: "E", qty: 5 });
+  });
+
+  test("a draft order without lines cannot be cancelled", async () => {
+    assert.deepEqual(await value({ step: "cancel", id: "o2" }), { refused: "not_confirmed" });
+  });
+
+  test("an unknown order cannot be cancelled", async () => {
+    assert.deepEqual(await value({ step: "cancel", id: "nope" }), { refused: "not_confirmed" });
+  });
+
+  test("cancelling is refused when a restock would go over the cap, and nothing changes", async () => {
+    await value({ step: "setStock", sku: "F", qty: 99 });
+    await value({ step: "placeOrder", id: "o4", customer_id: "c1", lines: [{ id: "l7", sku: "F", qty: 2, price: 1 }] });
+    assert.deepEqual(await value({ step: "confirm", id: "o4" }), { id: "o4", customer_id: "c1", status: "confirmed", note: null });
+    assert.deepEqual(await value({ step: "cancel", id: "o4" }), { refused: "restock_failed" });
+    assert.deepEqual(await value({ step: "order", id: "o4" }), { id: "o4", status: "confirmed", lines: [{ id: "l7", sku: "F", qty: 2, price: 1 }] });
+    assert.deepEqual(await value({ step: "stock", sku: "F" }), { sku: "F", qty: 99 });
+  });
 });
