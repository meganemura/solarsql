diff -r -u --exclude=node_modules --exclude=.runs-*.log --exclude=package-lock.json <starters>/solarsql/test/visible.test.ts <runs>/solarsql-1/test/visible.test.ts
--- <starters>/solarsql/test/visible.test.ts	2026-09-06 09:12:41
+++ <runs>/solarsql-1/test/visible.test.ts	2026-09-06 09:16:20
@@ -91,4 +91,18 @@
   test("an unknown order reads as null", async () => {
     assert.equal(await value({ step: "order", id: "nope" }), null);
   });
+
+  test("a draft order cannot be cancelled", async () => {
+    assert.deepEqual(await value({ step: "cancel", id: "o2" }), { refused: "not_confirmed" });
+    assert.deepEqual(await value({ step: "order", id: "o2" }), { id: "o2", status: "draft", lines: [] });
+  });
+
+  test("cancel a confirmed order, then cancel it again", async () => {
+    assert.deepEqual(await value({ step: "cancel", id: "o1" }), { id: "o1", customer_id: "c1", status: "cancelled", note: null });
+    assert.deepEqual(await value({ step: "cancel", id: "o1" }), { refused: "not_confirmed" });
+  });
+
+  test("an unknown order cannot be cancelled", async () => {
+    assert.deepEqual(await value({ step: "cancel", id: "nope" }), { refused: "not_confirmed" });
+  });
 });
