{
  "name": "solarsql",
  "version": "0.1.0",
  "description": "Typed SQL for SQLite on Cloudflare D1 and Durable Objects: types from the real engine at build time, a command as one transaction, failures as values.",
  "keywords": [
    "cloudflare",
    "workers",
    "d1",
    "durable-objects",
    "sqlite",
    "sql",
    "typescript",
    "migrations",
    "typed-sql"
  ],
  "license": "MIT",
  "author": "meganemura",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meganemura/solarsql.git"
  },
  "homepage": "https://github.com/meganemura/solarsql#readme",
  "bugs": "https://github.com/meganemura/solarsql/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.10.0"
  },
  "files": [
    "src",
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./d1": {
      "types": "./dist/d1.d.ts",
      "default": "./dist/d1.js"
    },
    "./durable": {
      "types": "./dist/durable.d.ts",
      "default": "./dist/durable.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "bin": {
    "solarsql": "./dist/build/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hegeldev/hegel": "0.4.5",
    "@types/node": "26.4.0",
    "miniflare": "5.20260828.0-alpha",
    "typescript": "7.0.2",
    "wrangler": "4.127.1"
  }
}
